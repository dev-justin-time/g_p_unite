# FCM Environment Variables — Copy to .env and fill in values
# .env is gitignored and will not be committed

# ── RPC Endpoints ──────────────────────────────────────────────
SEPOLIA_RPC=https://rpc.sepolia.org
FCM_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org

# ── Deployer Keys (separate testnet/mainnet!) ──────────────────
TESTNET_PRIVATE_KEY=0x...   # For Sepolia, Base Sepolia, Arbitrum Sepolia
MAINNET_PRIVATE_KEY=0x...   # For Base mainnet — NEVER commit this

# ── Block Explorer API Keys ────────────────────────────────────
ETHERSCAN_API_KEY=...       # For Sepolia contract verification
ARBISCAN_API_KEY=...
BASESCAN_API_KEY=...

# ── Per-Agent Keys (optional, falls back to PRIVATE_KEY) ──────
INFERENCE_ROUTER_KEY=0x...
RENDER_SPLITTER_KEY=0x...
FL_COORDINATOR_KEY=0x...
EDGE_RUNNER_KEY=0x...
ZK_PROVER_KEY=0x...
GAME_HOST_KEY=0x...
SCIENCE_GRID_KEY=0x...
PRIVACY_MESH_KEY=0x...

# ── Contracts (filled after deployment) ────────────────────────
FCM_TOKEN_CONTRACT=0x...
FCM_REGISTRY_CONTRACT=0x...
FCM_MARKETPLACE_CONTRACT=0x...
FCM_TIER_STAKING_CONTRACT=0x...
FCM_GOVERNANCE_CONTRACT=0x...
FCM_ESCROW_CONTRACT=0x...
FCM_REPUTATION_NFT_CONTRACT=0x...
FCM_REWARDS_POOL_CONTRACT=0x...

# ── Cloud Providers ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-west-2
HCLOUD_TOKEN=...

# ── Azure ──────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=...
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
AZURE_TENANT_ID=...

# ── Monitoring ─────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme   # REQUIRED — no default allowed
