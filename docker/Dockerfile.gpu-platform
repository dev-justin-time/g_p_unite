# ═══════════════════════════════════════════════════════════════
# GPU Platform GUI — Dockerfile
# Serves the unified platform GUI (gpu_nited.html) via nginx
# with optional obscura headless browser integration
# ═══════════════════════════════════════════════════════════════

# ── Stage 1: Build (optional Node.js backend) ───────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json* ./

# Install production dependencies only
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

# Copy GPU platform source
COPY gpu-platform/ ./gpu-platform/
COPY lib/modules/ ./lib/modules/
COPY config/ ./config/

# ── Stage 2: Production ─────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Security: run as non-root
RUN addgroup -g 1001 -S gpu && \
    adduser -S gpu -u 1001

# Install Node.js for WebSocket/obscura support
RUN apk add --no-cache \
    nodejs \
    npm \
    curl \
    tini && \
    rm -rf /var/cache/apk/*

# Copy Node.js dependencies from builder
COPY --from=builder /app/node_modules /opt/gpu-platform/node_modules
COPY --from=builder /app/lib /opt/gpu-platform/lib
COPY --from=builder /app/config /opt/gpu-platform/config

# Copy GPU platform static files
COPY gpu-platform/gpu_nited.html /usr/share/nginx/html/
COPY gpu-platform/css/ /usr/share/nginx/html/css/
COPY gpu-platform/js/ /usr/share/nginx/html/js/
COPY gpu-platform/config/ /usr/share/nginx/html/config/

# Copy nginx configuration
COPY docker/nginx-gpu.conf /etc/nginx/conf.d/default.conf

# Copy WebSocket proxy config
COPY docker/nginx-ws-proxy.conf /etc/nginx/conf.d/ws-proxy.conf.template

# Copy error pages
COPY docker/50x.html /usr/share/nginx/html/50x.html

# Create log and cache directories
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run /opt/gpu-platform/data && \
    chown -R gpu:gpu /var/log/nginx /var/cache/nginx /var/run /opt/gpu-platform

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Environment defaults
ENV GPU_PORT=9091 \
    GPU_HOST=0.0.0.0 \
    GPU_WS_ENABLED=true \
    GPU_WS_PORT=9092 \
    GPU_OBSURA_ENABLED=false \
    GPU_OBSURA_PORT=9222 \
    GPU_RPC_URL=http://localhost:8545 \
    GPU_REGISTRY_CONTRACT="" \
    GPU_AUTH_SECRET="" \
    GPU_AUTH_REQUIRED=false \
    NODE_ENV=production

# Expose ports
# 9091 = GUI HTTP
# 9092 = WebSocket
EXPOSE 9091 9092

# Copy entrypoint
COPY docker/entrypoint-gpu.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start nginx + optional Node.js services
CMD ["/entrypoint.sh"]
