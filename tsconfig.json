{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./lib/*"],
      "@agents/*": ["./agents/*"],
      "@modules/*": ["./lib/modules/*"],
      "@contracts/*": ["./contracts/solidity/*"]
    }
  },
  "include": [
    "lib/**/*.ts",
    "agents/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "cache",
    "deployments"
  ]
}
