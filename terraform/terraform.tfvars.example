# FCM Terraform Variables — Copy to terraform.tfvars and fill in values
# terraform.tfvars is gitignored and will not be committed

deployment_name     = "fcm-production"
fcm_token_contract  = "0x0000000000000000000000000000000000000000"
registry_contract   = "0x0000000000000000000000000000000000000000"
rpc_url             = "https://mainnet.base.org"

aws_region          = "us-west-2"
aws_access_key      = "AKIA..."
aws_secret_key      = "..."
hcloud_token        = "..."
azure_subscription_id = "..."
azure_client_id       = "..."
azure_client_secret   = "..."
azure_tenant_id       = "..."
